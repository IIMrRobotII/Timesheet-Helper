{
  "name": "timesheet-helper",
  "description": "Copy work hours from Hilan timesheet to Malam payroll, with an on-device salary estimate.",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "license": "GPL-3.0",
  "author": "Segev Levinshtein",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "check:manifest": "bun scripts/check-manifest.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,html}\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "tmp": "0.2.6",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  }
}
