{
  "name": "timesheet-helper",
  "description": "Copy work hours from Hilan timesheet to Malam payroll, with an on-device salary estimate.",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "license": "GPL-3.0",
  "author": "Segev Levinshtein",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "check:manifest": "bun scripts/check-manifest.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,html}\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.7",
    "esbuild": "0.28.1",
    "multimatch": "8.0.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.12.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wxt": "^0.20.27"
  }
}
